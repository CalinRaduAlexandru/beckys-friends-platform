{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beckys-garden",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-05",
  "routes": [
    { "pattern": "beckysgarden.ro", "custom_domain": true },
    { "pattern": "www.beckysgarden.ro", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "triggers": {
    "crons": ["17 5,13,21 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
